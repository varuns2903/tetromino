# Maintainer: Varun S <04varuns at gmail dot com>

pkgname=tetromino-bin
_pkgname=tetromino
pkgver=1.1.0
pkgrel=1
pkgdesc='Falling-block puzzle game for the terminal (prebuilt static binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/varuns2903/tetromino'
license=('MIT')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Already stripped, fully static release binary.
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('96d6881a24699be19e33318bb4488431505261533eb646c0dce8aa529ee9a946')
sha256sums_aarch64=('ed14f88a14f23365c6fcb81e1882e30ba77a222277a1332e94c349093521cd68')

package() {
  cd "$_pkgname-$pkgver-linux-$CARCH"
  install -Dm755 tetromino "$pkgdir/usr/bin/tetromino"
  install -Dm644 tetromino.6 "$pkgdir/usr/share/man/man6/tetromino.6"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
