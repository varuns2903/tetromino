# Maintainer: Varun S <04varuns at gmail dot com>

pkgname=tetromino
pkgver=1.0.1
pkgrel=1
pkgdesc='Falling-block puzzle game for the terminal, written from scratch in C++20 (termios + ANSI, no ncurses)'
arch=('x86_64' 'aarch64')
url='https://github.com/varuns2903/tetromino'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a56117cfc0aeacc480565ff5a9a4dfed9e660416f24ac85fae0b64bfe1475ed8')

build() {
  # CMAKE_BUILD_TYPE=None: use makepkg's CXXFLAGS instead of the project's.
  # Warnings stay on but aren't fatal, so a newer compiler can't break the build.
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DTETROMINO_WARNINGS_AS_ERRORS=OFF
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
